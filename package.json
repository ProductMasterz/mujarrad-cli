{
  "name": "mujarrad-cli",
  "version": "1.1.0-alpha.4",
  "description": "⚠️ ALPHA: Obsidian Knowledge Graph Integration CLI - Sync your Obsidian vaults with Mujarrad workspaces",
  "workspaces": [
    "packages/*"
  ],
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "mujarrad": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:performance": "jest --testPathPattern=tests/performance --runInBand",
    "test:integration": "jest --testPathPattern=tests/integration --runInBand",
    "test:all": "npm run test && npm run test:integration && npm run test:performance",
    "test:all-commands": "./scripts/test-commands.sh",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run build",
    "postinstall": "node scripts/postinstall.js || exit 0"
  },
  "keywords": [
    "obsidian",
    "knowledge-graph",
    "cli",
    "mujarrad",
    "note-taking",
    "vault",
    "sync",
    "markdown",
    "canvas"
  ],
  "author": "Mujarrad Team",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mujarrad/mujarrad-cli.git"
  },
  "bugs": {
    "url": "https://github.com/mujarrad/mujarrad-cli/issues"
  },
  "homepage": "https://www.mujarrad.com",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/"
  ],
  "dependencies": {
    "@napi-rs/keyring": "^1.2.0",
    "archiver": "^7.0.1",
    "axios": "^1.12.2",
    "chalk": "^5.3.0",
    "cli-progress": "^3.12.0",
    "commander": "^14.0.1",
    "cosmiconfig": "^8.3.6",
    "fast-redact": "^3.5.0",
    "gray-matter": "^4.0.3",
    "inquirer": "^12.9.6",
    "ora": "^7.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-parse": "^11.0.0",
    "simple-git": "^3.28.0",
    "unified": "^11.0.5",
    "unzipper": "^0.12.3",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.24.0",
    "@types/archiver": "^6.0.2",
    "@types/cli-progress": "^3.11.6",
    "@types/fast-redact": "^3.0.4",
    "@types/inquirer": "^9.0.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/unzipper": "^0.10.11",
    "ci-info": "^4.1.0",
    "jest": "^29.7.0",
    "nock": "^13.5.0",
    "ts-jest": "^29.4.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
